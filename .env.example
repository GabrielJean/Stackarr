# Host identity and application storage
PUID=950
PGID=950
TZ=America/New_York
APPDATA=/Apps
DOWNLOADS_PATH=/Downloads
MEDIA_PATH=/Media

# Local network used to access the qBittorrent Web UI through Gluetun
LAN_SUBNET=192.168.10.0/24

# Homepage dashboard. Use the server's LAN IP address or hostname.
HOMEPAGE_PORT=3001
STACKARR_URL=http://192.168.10.10
HOMEPAGE_ALLOWED_HOSTS=192.168.10.10:3001,localhost:3001,127.0.0.1:3001

# Gluetun uses the PIA WireGuard profile generated by setup.sh at
# ${APPDATA}/gluetun/wireguard/wg0.conf. PIA credentials are not stored here.

# NVIDIA GPU used by Plex. Set to 1 to enable GPU transcoding.
PLEX_GPU_COUNT=0
NVIDIA_VISIBLE_DEVICES=all

# Optional host-port overrides
DOCKHAND_PORT=3000
QBITTORRENT_PORT=8080
TORRENT_PORT=6881
SONARR_PORT=8989
RADARR_PORT=7878
JACKETT_PORT=9117
SEERR_PORT=5055
